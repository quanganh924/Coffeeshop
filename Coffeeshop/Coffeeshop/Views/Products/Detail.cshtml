@model Coffeeshop.Models.Product

<br />

<div class="container" style="background-color: white; padding: 2rem; border-radius: 8px; color: black;">
    <div class="card-wrapper">
        <div class="row align-items-center">

            <div class="col-12 col-lg-6">
                <div class="image-wrapper">
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid">
                </div>
            </div>

            <div class="col-12 col-lg">
                <div class="text-box">

                    <h5 class="mbr-title mbr-fonts-style display-2 text-dark">
                        <strong>@Model.Name</strong>
                    </h5>

                    <p class="mbr-text mbr-fonts-style display-7 text-dark">
                        @Model.Detail
                    </p>

                    <div class="cost">
                        <span class="currentcost mbr-fonts-style pr-2 display-2 text-dark">
                            @Model.Price.ToString("c")
                        </span>
                    </div>

                    <div class="mbr-section-btn pt-3">
                        <a href="" class="btn btn-primary display-4">
                            <span class="mbrib-cart-add mbr-iconfont mbr-iconfont-btn"></span>
                            Add to cart
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<br />
